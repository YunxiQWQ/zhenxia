{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Zhenxia",
  "version": "0.2.1",
  "identifier": "local.yunxi.zhenxia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "帧匣 Zhenxia",
        "width": 1040,
        "height": 700,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": false,
        "skipTaskbar": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Yunxi",
    "copyright": "Copyright © 2026 Brandon South and contributors; Zhenxia modifications © 2026 Yunxi",
    "shortDescription": "Clipboard history, screenshots and pinned images",
    "longDescription": "Zhenxia combines Cubby clipboard history with LaterScreen capture and annotation engines. Data is stored locally in an encrypted database.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "zlib",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "licenseFile": "../LICENSE",
    "resources": {
      "../README.md": "README.md",
      "../LICENSE": "LICENSE",
      "../LICENSE-LaterScreen.txt": "LICENSE-LaterScreen.txt",
      "../LICENSE-SnowAir.txt": "LICENSE-SnowAir.txt",
      "../NOTICE.md": "NOTICE.md",
      "../NOTICE-SnowAir.txt": "NOTICE-SnowAir.txt",
      "../LICENSE-NOTICES.md": "LICENSE-NOTICES.md",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../OPTIONAL-COMPONENTS.md": "OPTIONAL-COMPONENTS.md",
      "../LICENSES/": "LICENSES/"
    }
  },
  "mainBinaryName": "Zhenxia"
}
